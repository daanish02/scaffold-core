---
// No props: reads h2/h3 headings from the rendered .prose content client-side,
// since Astro slots render to static HTML before this component can inspect them.
---

<nav class="toc" id="toc" aria-label="On this page">
  <div class="toc-label">On this page</div>
  <div class="toc-list" id="tocList"></div>
</nav>

<script>
  const toc = document.getElementById("toc");
  const list = document.getElementById("tocList");
  if (toc && list) {
    const headings = Array.from(
      document.querySelectorAll<HTMLHeadingElement>(".prose h2, .prose h3"),
    );

    if (headings.length === 0) {
      toc.style.display = "none";
    } else {
      headings.forEach((h, i) => {
        if (!h.id) h.id = `toc-heading-${i}`;
        const link = document.createElement("a");
        link.href = `#${h.id}`;
        link.textContent = h.textContent;
        link.className = h.tagName === "H3" ? "toc-link toc-link-sub" : "toc-link";
        list.appendChild(link);
      });

      const links = Array.from(list.querySelectorAll<HTMLAnchorElement>(".toc-link"));
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              links.forEach((l) =>
                l.classList.toggle("active", l.getAttribute("href") === `#${id}`),
              );
            }
          }
        },
        { rootMargin: "-20% 0px -70% 0px" },
      );
      headings.forEach((h) => observer.observe(h));
    }
  }
</script>

<style>
  .toc {
    width: 200px;
    flex-shrink: 0;
    display: none;
    font-family: var(--sans);
    font-size: 13px;
    position: sticky;
    top: 80px;
    align-self: flex-start;
    max-height: calc(100dvh - 100px);
    overflow-y: auto;
  }
  .toc-label {
    color: var(--ink-faint);
    font-size: 11.5px;
    font-weight: 500;
    margin-bottom: 10px;
  }
  .toc-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-left: 1px solid var(--rule);
  }
  .toc-link {
    padding: 2px 0 2px 14px;
    color: var(--ink-faint);
    text-decoration: none;
    line-height: 1.4;
  }
  .toc-link-sub {
    padding-left: 26px;
    font-size: 12.5px;
  }
  .toc-link:hover {
    color: var(--ink);
  }
  .toc-link.active {
    color: var(--accent-ink);
    font-weight: 500;
  }
  @media (min-width: 1200px) {
    .toc {
      display: block;
    }
  }
</style>
