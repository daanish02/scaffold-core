{
  "name": "@daanish02/scaffold-core",
  "version": "0.0.0",
  "description": "Shared components, design system, content schema, KB registry, and reusable CI workflow for the Scaffold family of knowledge bases.",
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "exports": {
    "./astro/*": "./astro/*",
    "./components/*": "./components/*",
    "./styles/*": "./styles/*",
    "./registry/*": "./registry/*"
  },
  "files": [
    "astro",
    "components",
    "styles",
    "registry",
    "scripts",
    "workflows",
    "docs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "astro": "^4.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "astro": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.5.0"
  }
}
