---
import kbs from "../../registry/kbs.json";
import { kbDisplayName } from "../../astro/content-schema.ts";

export interface Props {
  currentKb: string;
}
const { currentKb } = Astro.props;
---

<div class="label">Part of the Scaffold family</div>
<div class="family-grid">
  {
    kbs.map((entry) =>
      entry.name === currentKb ? (
        <span class="family-link self">{kbDisplayName(entry.name)}</span>
      ) : (
        <a class="family-link" href={entry.url}>
          {kbDisplayName(entry.name)}
        </a>
      ),
    )
  }
</div>
