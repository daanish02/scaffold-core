{
  "name": "@daanish02/scaffold-core",
  "version": "0.0.0",
  "description": "Shared components, design system, content schema, KB registry, and reusable CI workflow for the Scaffold family of knowledge bases.",
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "exports": {
    "./astro/*": "./astro/*",
    "./components/*": "./components/*",
    "./styles/*": "./styles/*",
    "./registry/*": "./registry/*"
  },
  "files": [
    "astro",
    "components",
    "styles",
    "registry",
    "scripts",
    "workflows",
    "docs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset"
  },
  "peerDependencies": {
    "astro": "^4.0.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^3.0.0",
    "@astrojs/react": "^3.0.0",
    "astro-pagefind": "^1.0.0",
    "gray-matter": "^4.0.0",
    "mafs": "^0.21.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "rehype-katex": "^7.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "astro": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.5.0"
  }
}
